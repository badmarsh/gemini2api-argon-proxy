{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BabysitFinding",
  "description": "Schema for findings reported by Monitor observing Argon, proxy, pool, refresher, and semantic invariants",
  "type": "object",
  "required": [
    "finding_id",
    "category",
    "severity",
    "confidence",
    "summary",
    "evidence",
    "proposed_fix"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^finding_[0-9a-zA-Z_-]+$",
      "description": "Unique finding identifier"
    },
    "category": {
      "type": "string",
      "enum": [
        "argon",
        "proxy",
        "pool_cookies",
        "refresher_noise",
        "orchestrator",
        "semantic_invariant",
        "streaming"
      ],
      "description": "Classification category of the finding"
    },
    "invariant_type": {
      "type": "string",
      "enum": [
        "leaked_refusal_phrase",
        "internal_code_interpreter_leak",
        "prose_refusal_instead_of_tool",
        "tool_repetition_loop",
        "artifact_missing",
        "artifact_invalid",
        "stream_chunk_stall",
        "early_stream_refusal_leak",
        "stream_error",
        "substitution_detected",
        "none"
      ],
      "description": "Deterministic semantic invariant classification"
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "error", "critical"],
      "description": "Severity of the issue"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score based strictly on concrete evidence"
    },
    "summary": {
      "type": "string",
      "maxLength": 256,
      "description": "Concise factual summary of the observation"
    },
    "evidence": {
      "type": "object",
      "required": ["request_id", "timestamp", "quoted_log"],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "Exact request_id from proxy debug record (or 'n/a' if system event)"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO-8601 UTC timestamp of occurrence"
        },
        "quoted_log": {
          "type": "string",
          "description": "Verbatim quote from proxy log, timeline, agent response, or refresher log"
        },
        "metric_name": {
          "type": "string",
          "description": "Optional metric key (e.g. ttft_ms, error_class, max_inter_chunk_gap_ms, repetitions)"
        },
        "metric_value": {
          "description": "Observed metric value"
        },
        "task_id": {
          "type": "string",
          "description": "Task ID associated with this finding, if applicable"
        },
        "snippet": {
          "type": "string",
          "description": "Code or text snippet illustrating the failure"
        }
      },
      "additionalProperties": true
    },
    "root_cause_hypothesis": {
      "type": "string",
      "description": "Plausible explanation of cause, explicitly labelled as hypothesis"
    },
    "proposed_fix": {
      "type": "string",
      "description": "Actionable engineering recommendation to prevent or resolve the issue"
    },
    "created_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp when finding was authored"
    },
    "task_id": {
      "type": "string",
      "description": "Optional root-level task ID reference"
    }
  },
  "additionalProperties": true
}
