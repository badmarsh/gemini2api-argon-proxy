{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BabysitTask",
  "description": "Schema for synthetic tasks generated by Orchestrator for Argon 4 agent with streaming, vision, protocol, and fixture support",
  "type": "object",
  "required": [
    "task_id",
    "category",
    "difficulty",
    "title",
    "prompt",
    "tools",
    "expected_behavior"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task_[0-9a-zA-Z_-]+$",
      "description": "Unique task identifier"
    },
    "category": {
      "type": "string",
      "enum": [
        "tool_use",
        "multistep_planning",
        "long_context",
        "faulty_ambiguous",
        "tool_recovery",
        "filesystem",
        "stall_resistance",
        "format_constraints",
        "streaming_imperative",
        "refusal_stress",
        "responses_protocol",
        "multimodal_vision",
        "investigation"
      ],
      "description": "Taxonomy category of the task"
    },
    "difficulty": {
      "type": "string",
      "enum": ["low", "medium", "high", "extreme"],
      "description": "Difficulty level of the task"
    },
    "protocol": {
      "type": "string",
      "enum": ["chat_completions", "responses"],
      "default": "chat_completions",
      "description": "API protocol to use for this task"
    },
    "stream": {
      "type": "boolean",
      "default": false,
      "description": "Whether to invoke the endpoint with SSE streaming"
    },
    "title": {
      "type": "string",
      "maxLength": 128,
      "description": "Short descriptive title of the task"
    },
    "prompt": {
      "type": "string",
      "description": "Input prompt sent to the Argon agent"
    },
    "initial_files": {
      "type": "array",
      "description": "Initial files to seed into the sandbox before task execution",
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "multimodal_input": {
      "type": "object",
      "description": "Optional multimodal attachment (e.g. image) to include in the user prompt",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["image"] },
        "image_url": { "type": "string" },
        "image_path": { "type": "string" },
        "detail": { "type": "string", "enum": ["auto", "low", "high"] }
      }
    },
    "tools": {
      "type": "array",
      "description": "Function tools available to Argon for this task",
      "items": {
        "type": "object",
        "required": ["type", "function"],
        "properties": {
          "type": { "type": "string", "enum": ["function"] },
          "function": {
            "type": "object",
            "required": ["name", "description", "parameters"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "parameters": { "type": "object" }
            }
          }
        }
      }
    },
    "expected_behavior": {
      "type": "object",
      "required": ["success_criteria", "timeout_seconds"],
      "properties": {
        "success_criteria": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "type": "string" }
          ],
          "description": "Checkable criteria to determine if the task passed"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Maximum allowed turn iterations"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 60,
          "default": 360,
          "description": "Timeout in seconds (must be >= 360 for Argon)"
        },
        "expected_artifacts": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["path"],
                "properties": {
                  "path": { "type": "string" },
                  "min_size": { "type": "integer" },
                  "must_contain": { "type": "array", "items": { "type": "string" } },
                  "is_json": { "type": "boolean" }
                }
              }
            ]
          },
          "description": "Files expected to be created in the sandbox"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
